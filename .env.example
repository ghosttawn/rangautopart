# Local development only. Never put real secrets in this file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
NODE_ENV=development
PORT=5000
FRONTEND_ORIGINS=http://localhost:5173

# Initial administrator account. On startup the API creates this account once,
# only when no administrator exists yet; it never resets an existing account.
# Required in production (set them in the Render API service Environment tab).
# Optional in development: when both are unset, development uses the documented
# fallback admin@rang-auto-parts.test / rang-development-admin.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=choose-a-strong-password-of-at-least-12-characters

# Set to the API service origin for a separately hosted frontend.
# Leave blank for same-origin development; set for a separately hosted frontend.
VITE_API_BASE_URL=
VITE_REQUIRE_API_BASE_URL=false
